# ==============================================================================
# Application Tracker - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your local settings.
# NEVER commit .env to version control!
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=application_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Backend Server Configuration
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/application_tracker
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Encryption Secret Key for Token Storage (AES-256-GCM, 32-byte hex or base64 or secure passphrase)
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth2 Credentials (for Gmail API integration)
# Minimum required scope: https://www.googleapis.com/auth/gmail.readonly
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080
